# ============================================================
# 环境变量模板
# 用法：复制为 .env 后填写（.env 已被 .gitignore 忽略，不会提交）
#   Windows:  copy .env.example .env
#   Linux  :  cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# 1) Jira 凭据 —— 任务执行时必需（run_jql_with_skill_demo.py 子进程读取）
# ------------------------------------------------------------
JIRA_BOT_SERVER=https://jira.amlogic.com
JIRA_BOT_USERNAME=
JIRA_BOT_PASSWORD=

# （可选）当 JIRA_BOT_* 未设置时的回退凭据
# JIRA_USERNAME=
# JIRA_PASSWORD=

# ------------------------------------------------------------
# 2) 邮件通知 —— 可选（任务完成后发送结果报告）
# ------------------------------------------------------------
SMTP_HOST=mail-sh.amlogic.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
BATCH_ANALYSIS_EMAIL=

# ------------------------------------------------------------
# 3) FastAPI 后端（process_skills/server）
# ------------------------------------------------------------
SKILL_API_HOST=127.0.0.1
SKILL_API_PORT=1238

# 前后端共享密钥：留空则后端自动生成 server_data/.api_token 并复用
# SKILL_API_TOKEN=

# ------------------------------------------------------------
# 4) Skill 根目录 —— 可选（默认推导为 Rubick/AmlAgent/expert-skills/log_analyse_skills）
# ------------------------------------------------------------
# SKILL_DIR_ROOT=

# ------------------------------------------------------------
# 5) 前端（aml_skill_review，均为可选，有默认值）
# ------------------------------------------------------------
SKILL_API_BASE=http://127.0.0.1:1238
MAX_CONCURRENT_TASKS=2
# USER_DATA_DIR_ROOT=